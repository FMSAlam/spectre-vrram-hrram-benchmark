	Xcell_7_6 ( p6 r7 c6 plane_out gnd_ref ) inca_2t1r_cell_hfo2 x0=1.0
	Xcell_7_7 ( p7 r7 c7 plane_out gnd_ref ) inca_2t1r_cell_hfo2 x0=1.0
ends inca_8x8_array

// 3x3 Window Inputs (P0..P2 Driven, P3..P7 Grounded)
Vp0 (p0 0) vsource type=pulse val0=0 val1=0.5 period=100n delay=70n rise=1n fall=1n width=10n
Vp1 (p1 0) vsource type=pulse val0=0 val1=0.5 period=100n delay=70n rise=1n fall=1n width=10n
Vp2 (p2 0) vsource type=pulse val0=0 val1=0.5 period=100n delay=70n rise=1n fall=1n width=10n
Vp3 (p3 0) vsource type=dc dc=0
Vp4 (p4 0) vsource type=dc dc=0
Vp5 (p5 0) vsource type=dc dc=0
Vp6 (p6 0) vsource type=dc dc=0
Vp7 (p7 0) vsource type=dc dc=0

// Row Select Gates (TR1)
Vr0 (r0 0) vsource type=dc dc=1.1
Vr1 (r1 0) vsource type=dc dc=1.1
Vr2 (r2 0) vsource type=dc dc=1.1
Vr3 (r3 0) vsource type=dc dc=0.0
Vr4 (r4 0) vsource type=dc dc=0.0
Vr5 (r5 0) vsource type=dc dc=0.0
Vr6 (r6 0) vsource type=dc dc=0.0
Vr7 (r7 0) vsource type=dc dc=0.0

// Col Select Gates (TR2)
Vc0 (c0 0) vsource type=dc dc=1.1
Vc1 (c1 0) vsource type=dc dc=1.1
Vc2 (c2 0) vsource type=dc dc=1.1
Vc3 (c3 0) vsource type=dc dc=0.0
Vc4 (c4 0) vsource type=dc dc=0.0
Vc5 (c5 0) vsource type=dc dc=0.0
Vc6 (c6 0) vsource type=dc dc=0.0
Vc7 (c7 0) vsource type=dc dc=0.0

// Shared Collection Plane Resistor Load
Rload (plane_out 0) resistor r=1.0

// Instantiate Macro
Xmacro ( p0 p1 p2 p3 p4 p5 p6 p7 r0 r1 r2 r3 r4 r5 r6 r7 c0 c1 c2 c3 c4 c5 c6 c7 plane_out 0 ) inca_8x8_array

tran_analysis tran stop=120n errpreset=moderate
saveOptions options rawfmt=psfascii
save plane_out p0 p1 p2 p3 p4 r0 r1 r2 r3 c0 c1 c2 c3 Xmacro.Xcell_0_0.n1 Xmacro.Xcell_0_0.n2