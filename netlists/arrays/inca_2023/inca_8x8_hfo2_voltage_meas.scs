// Spectre Netlist: 2023 3D INCA 8x8 Array - HfO2 (VOLTAGE MEASUREMENT)
// Architecture: Kim et al. (HPCA 2023) 2T1R Input-Stationary Dataflow
// Baseline Node: FreePDK 45nm CMOS | Workload: 3x3 Spatial Gated Conv Window

simulator lang=spectre
global 0

include "$FREEPDK45_DIR/ncsu_basekit/models/hspice/tran_models/models_nom/NMOS_VTG.inc"
include "../../cells/inca_2t1r_cell_hfo2.scs"

// 8x8 INCA Subarray Macro (HfO2)
subckt inca_8x8_array ( p0 p1 p2 p3 p4 p5 p6 p7 r0 r1 r2 r3 r4 r5 r6 r7 c0 c1 c2 c3 c4 c5 c6 c7 plane_out gnd_ref )
	Xcell_0_0 ( p0 r0 c0 plane_out gnd_ref ) inca_2t1r_cell_hfo2 x0=1.0
	Xcell_0_1 ( p1 r0 c1 plane_out gnd_ref ) inca_2t1r_cell_hfo2 x0=1.0
	Xcell_0_2 ( p2 r0 c2 plane_out gnd_ref ) inca_2t1r_cell_hfo2 x0=1.0
